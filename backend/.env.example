# Backend-only env file for FastAPI. Do not commit real credentials.
# Use DB_URI for hosted PostgreSQL (for example, Neon).
DB_URI=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# SQLite fallback for local development if DB_URI is omitted.
DATABASE_URL=/data/codexforge.sqlite3
# Frontend origin allowed by CORS and Socket.IO.
CLIENT_ORIGIN=http://localhost:3000
# GitHub OAuth App values. Homepage URL should be CLIENT_ORIGIN.
# Authorization callback URL should be http://localhost:8000/api/auth/github/callback locally
# or https://YOUR_BACKEND_HOST/api/auth/github/callback in production.
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
CODEX_API_KEY=replace-me
WORKSPACE_ROOT=/data/repos
