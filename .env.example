# Frontend env file for Next.js/Vercel.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000
# Public app URL. Use http://localhost:3000 locally and your Vercel URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me
# Backend-only secrets below are listed for local full-stack development only.
# In production, set them on the backend host, not as public Vercel client variables.
DB_URI=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLIENT_ORIGIN=http://localhost:3000
GITHUB_CLIENT_ID=replace-me
GITHUB_CLIENT_SECRET=replace-me
GITHUB_OAUTH_CALLBACK_URL=http://localhost:8000/api/auth/github/callback
CODEX_API_KEY=replace-me
